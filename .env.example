# Copy to .env and adjust as needed. These are the variables read by
# packages/shared/src/env.ts's loadEnv.

# Required. Postgres connection string. The value below matches the
# postgres service in docker-compose.yml.
DATABASE_URL=postgresql://forge:forge@postgres:5432/forge

# Optional. Defaults to 3000.
PORT=3000

# Optional. SMTP delivery defaults to the local Docker Compose Mailpit service.
# Its inbox is available at http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=Forge <notifications@forge.local>

# Optional. S3-compatible object storage for grading reports and logs.
# These all default to this repo's docker-compose MinIO service and only
# need overriding when running outside Docker Compose.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=forge
# S3_SECRET_ACCESS_KEY=forgeforge
# S3_BUCKET=forge-reports
# S3_FORCE_PATH_STYLE=true
